# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in real values.
# `.env.local` is git-ignored — never commit real credentials.
# ---------------------------------------------------------------------------

# --- Site -------------------------------------------------------------------
# Canonical production origin, no trailing slash. Used for metadataBase,
# canonical URLs, the sitemap and robots.txt. Falls back to the Vercel
# production URL, then https://withshawon.vercel.app.
NEXT_PUBLIC_SITE_URL=https://withshawon.vercel.app

# --- Supabase ---------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- Contact form email (server-only) ---------------------------------------
# Gmail account that sends the contact-form notifications.
# The password below must be a Google *App Password* (16 characters, requires
# 2-Step Verification enabled) — never your real account password:
#   https://myaccount.google.com/apppasswords
CONTACT_EMAIL_USER=your_gmail_address@gmail.com
CONTACT_EMAIL_APP_PASSWORD=your_16_char_google_app_password

# Optional. Where contact-form messages are delivered.
# Defaults to asifbhuiyanshawon@gmail.com when unset.
# CONTACT_EMAIL_TO=asifbhuiyanshawon@gmail.com

# --- Cloudflare Turnstile (spam protection) ---------------------------------
# Shared by the blog comment form and the contact form. If these are unset the
# contact API skips the challenge, so local development works without them.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key

# --- AI tools ---------------------------------------------------------------
# Groq API Key - Get it from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Keep your existing Gemini key if you have one
# GEMINI_API_KEY=your_gemini_api_key_here
NEXT_PUBLIC_GA_ID=G-xxxxxxxx
